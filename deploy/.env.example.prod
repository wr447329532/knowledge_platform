JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ALLOW_ORIGINS=http://127.0.0.1,http://YOUR_SERVER_IP
BOOTSTRAP_DEFAULT_ADMIN=true
RESET_DEFAULT_ADMIN_PASSWORD_ON_STARTUP=false
DB_AUTO_CREATE_TABLES_ON_STARTUP=false
DB_COMPAT_PATCH_ON_STARTUP=false

# Prefer PostgreSQL in production (example):
# DATABASE_URL=postgresql+psycopg2://kp_user:kp_password@127.0.0.1:5432/knowledge_platform
#
# If you still use SQLite in production, point to an absolute path:
DATABASE_URL=sqlite:////opt/knowledge_platform/data/app.db

# Storage root path for uploaded files
STORAGE_ROOT=/opt/knowledge_platform/storage

# System total quota in bytes (example: 2TB)
STORAGE_SYSTEM_TOTAL_BYTES=2199023255552
