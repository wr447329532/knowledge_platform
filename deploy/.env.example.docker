# 数据库密码（docker-compose 中 PostgreSQL 与应用 DATABASE_URL 共用，必填）
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
STORAGE_SYSTEM_TOTAL_BYTES=1099511627776
# 单文件上传上限（字节），默认 2147483648 = 2GB
# MAX_UPLOAD_FILE_BYTES=2147483648
CORS_ALLOW_ORIGINS=http://127.0.0.1,http://YOUR_SERVER_IP

# 可选：本机构建镜像名保持默认即可。服务器只 pull GHCR 时请改用 deploy/.env.example.ghcr
# DOCKER_IMAGE_APP=knowledge_platform-app:latest
# DOCKER_IMAGE_NGINX=knowledge_platform-nginx:latest
