# 服务器仅 pull 部署（镜像由 GitHub Actions 构建并推送到 GHCR）
# 复制为项目根目录 .env 后填写：cp deploy/.env.example.ghcr .env

# --- 必填：与 docker-compose 中 db / DATABASE_URL 一致 ---
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# --- 必填：JWT（不可用示例默认值）---
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# --- 镜像：把 YOUR_GHCR_OWNER 换成 GitHub 用户名（必须小写，与 GHCR 路径一致）---
DOCKER_IMAGE_APP=ghcr.io/YOUR_GHCR_OWNER/knowledge_platform-app:latest
DOCKER_IMAGE_NGINX=ghcr.io/YOUR_GHCR_OWNER/knowledge_platform-nginx:latest

STORAGE_SYSTEM_TOTAL_BYTES=1099511627776
CORS_ALLOW_ORIGINS=http://127.0.0.1,http://YOUR_SERVER_IP
GUNICORN_WORKERS=4
