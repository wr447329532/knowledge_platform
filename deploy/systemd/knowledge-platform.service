[Unit]
Description=Knowledge Platform Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/knowledge_platform
EnvironmentFile=/opt/knowledge_platform/.env
ExecStart=/opt/knowledge_platform/.venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
TimeoutStopSec=30

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/knowledge_platform/storage /opt/knowledge_platform/data

[Install]
WantedBy=multi-user.target
